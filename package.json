{
  "name": "@daropotter/opencode-filelink",
  "version": "0.1.0",
  "description": "opencode 2.x plugin that makes local file links in the TUI clickable: reveal in the file manager, open in the default app, or jump to a line in your editor.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tui",
    "file-links",
    "file-manager",
    "reveal",
    "editor"
  ],
  "license": "MIT",
  "author": "Daro",
  "repository": "github:daropotter/opencode-filelink",
  "homepage": "https://github.com/daropotter/opencode-filelink#readme",
  "bugs": "https://github.com/daropotter/opencode-filelink/issues",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "opencode": ">=2.2.0",
    "bun": ">=1.2.0",
    "node": ">=20"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0 <3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
